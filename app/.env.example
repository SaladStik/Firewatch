# Copy this file to .env and fill it in. .env is gitignored.
#
# Two ElevenLabs settings, and the difference matters: one is public and one is not.

# Firefly's voice and brain — the agent the dock connects to. Set the agent up from
# src/firefly/AGENT.md, then paste its id here. VITE_ means Vite inlines it into the shipped
# JavaScript, so it is readable by anyone on the deployed site; that is fine for an agent id
# (there is no key behind it), but restrict it with the agent's host allowlist in the
# ElevenLabs dashboard. Without it the dock says Firefly is offline and the map works as normal.
VITE_ELEVENLABS_AGENT_ID=

# The Ask panel speaks its replies through server/speak.ts. This one is a real API key with no
# VITE_ prefix, so it stays on the server and never reaches the browser. Keep it that way.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional. Default voice is Grandpa Spuds Oxley.
# ELEVENLABS_VOICE_ID=NOpBlnGInO9m6vDvFkFC
