# Copy this file to .env and fill it in. .env is gitignored.
#
# Firefly's voice and brain: the ElevenLabs agent the dock connects to. Set the agent up
# from src/firefly/AGENT.md, then paste its id here. Without it the dock says Firefly is
# offline and the rest of the map works as normal.
VITE_ELEVENLABS_AGENT_ID=
