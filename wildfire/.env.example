# Copy this file to .env and edit it. .env is gitignored.
# Do not put Wi-Fi passwords in this project. The Arduino sketch reads those
# from the Arduino sketch's secrets.h, which is also gitignored.

# USB serial port for the sensor sketch. Leave blank to use the one Arduino
# plugged into this PC. Close the Arduino Serial Monitor before starting the app;
# Windows only lets one program open the port.
# ARDUINO_PORT=COM6
ARDUINO_PORT=
ARDUINO_BAUD=9600

# Wi-Fi mode, used only when ARDUINO_PORT is empty and no USB Arduino is found.
# Example: ARDUINO_URL=http://192.168.1.50
ARDUINO_URL=

# JSON endpoint served by the sketch. Appended to ARDUINO_URL.
ARDUINO_SENSOR_PATH=/api/sensor

# The sensor is slow. Values outside 5-10 seconds are clamped.
SENSOR_POLL_INTERVAL_SECONDS=8
SENSOR_HTTP_TIMEOUT_SECONDS=3
SENSOR_STALE_AFTER_SECONDS=30

# Wind speed is required by the Fosberg index and is NOT measured by the station.
# Leave this blank to withhold a risk score until you enter wind speed in the
# dashboard, or set LATITUDE and LONGITUDE to read 10 m wind from Open-Meteo.
WIND_SPEED_MPH=
WIND_SPEED_SOURCE=manual

# Optional site for supplemental weather. Temperature and humidity still come
# from the Arduino. Open-Meteo does not need an API key.
LATITUDE=
LONGITUDE=

SQLITE_PATH=data/wildfire.sqlite
ENABLE_POLLER=1
HOST=0.0.0.0
PORT=8000

# Run:
#   python -m venv .venv
#   .venv\Scripts\activate
#   pip install -r requirements.txt
#   copy .env.example .env
#   python -m app
#
# Without the Arduino:
#   python -m app.mock_arduino
#   Set ARDUINO_URL=http://127.0.0.1:8081 and a WIND_SPEED_MPH, then python -m app
#
# Tests:
#   python -m pytest
